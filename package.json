{
  "name": "pi-tau-web-server",
  "version": "1.1.9",
  "description": "Web browser workspace for Pi — a standalone web server that manages multiple live Pi RPC sessions in parallel.",
  "keywords": [
    "pi",
    "pi-package",
    "pi-coding-agent",
    "pi-tau",
    "tau",
    "pi-web",
    "pi-web-ui",
    "pi-webui",
    "pi-web-server",
    "pi-ui",
    "pi-rpc",
    "pi-session",
    "pi-session-manager",
    "pi-extensions",
    "ai-agent",
    "ai-coding-agent",
    "coding-agent",
    "harness",
    "llm",
    "web-ui",
    "webui",
    "web-server",
    "websocket",
    "rpc",
    "standalone",
    "multi-session",
    "self-hosted",
    "pwa",
    "mobile"
  ],
  "author": {
    "name": "Milan Glacier",
    "email": "dev@milanglacier.com",
    "url": "https://github.com/milanglacier"
  },
  "contributors": [
    {
      "name": "deflating",
      "url": "https://github.com/deflating"
    }
  ],
  "license": "MIT",
  "homepage": "https://github.com/milanglacier/pi-tau-web-server#readme",
  "bugs": {
    "url": "https://github.com/milanglacier/pi-tau-web-server/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/milanglacier/pi-tau-web-server.git"
  },
  "type": "module",
  "main": "./bin/tau.js",
  "bin": {
    "pi-tau-web-server": "./bin/tau.js"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "bin",
    "public",
    "scripts",
    "src",
    "tsconfig.json",
    "tsconfig.server.json",
    "tsconfig.public.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.server.json && tsc -p tsconfig.public.json && node scripts/copy-katex.ts && node scripts/copy-highlight.ts",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.public.json --noEmit && tsc -p tsconfig.test.json",
    "test": "npm run build && node --test test/*.test.ts",
    "test:e2e": "bash scripts/e2e.sh"
  },
  "dependencies": {
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.86.0 <2.0.0",
    "@highlightjs/cdn-assets": "^11.12.0",
    "@types/node": "^26.1.1",
    "@types/ws": "^8.18.1",
    "katex": "^0.18.1",
    "playwright": "1.61.1",
    "typescript": "^7.0.2"
  }
}
